{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": { "service": "backend" }
    },
    {
      "source": "/jd/:path*",
      "destination": { "service": "backend" }
    },
    {
      "source": "/resume/:path*",
      "destination": { "service": "backend" }
    },
    {
      "source": "/talent-check/:path*",
      "destination": { "service": "backend" }
    },
    {
      "source": "/match/:path*",
      "destination": { "service": "backend" }
    },
    {
      "source": "/mock-interview/:path*",
      "destination": { "service": "backend" }
    },
    {
      "source": "/health",
      "destination": { "service": "backend" }
    },
    {
      "source": "/companies",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
